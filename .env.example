# Coqui TTS Server v1.7.0 — Environment Configuration
# Copy to .env and adjust. All variables have sensible defaults.

# --- Server ---
DEBUG=false

# --- Model ---
TTS_MODEL=tts_models/multilingual/multi-dataset/xtts_v2
# TTS_HOME=assets/models          # Where Coqui downloads/caches models
# VOICE_ASSET_DIR=assets/voices   # Where voice WAVs and voices.json live
# AUDIO_CACHE_DIR=assets/cache    # Synthesized audio cache
# CACHE_TTL_MINUTES=10080         # Cache expiry (default: 7 days, 0=disabled)

# --- Precision ---
# fp32 (default, recommended for production), fp16, or bf16
# bf16 saves ~0.7 GB/worker but 7% slower under load. fp16 risks overflow on long texts.
COQUI_PRECISION=fp32
# Legacy: COQUI_FP16=1 still works (maps to fp16)

# --- Personality Defaults ---
# DEFAULT_VOICE=alloy              # Default voice when not specified in request
DEFAULT_LANGUAGE=en
# DEFAULT_TEMPERATURE=0.75
# DEFAULT_LENGTH_PENALTY=1.0
# DEFAULT_REPETITION_PENALTY=5.0
# DEFAULT_TOP_K=50
# DEFAULT_TOP_P=0.85

# --- Cold Worker Pool ---
COLD_POOL_SIZE=6                   # Max concurrent cold workers (safety cap)
COLD_WORKER_IDLE_TIMEOUT=60        # Base idle timeout (seconds) before worker exits
COLD_WORKER_IDLE_STAGGER=10        # Stagger added per worker slot to avoid mass die-off
# COLD_POOL_MANAGER_INTERVAL=0.5   # How often pool manager checks queue (seconds)
# MIN_COLD_VRAM_GB=2.5             # Min free VRAM to spawn a cold worker (0=disable)
# HOT_QUEUE_SAFETY_FACTOR=0.8      # Bias toward hot lane (lower=more conservative)

# --- Routing (for front-end Gatekeeper) ---
# ROUTING_DRAIN_CAP_SECONDS=120    # Queue drain time considered 100% load

# --- Redis (node self-registration, opt-in) ---
# Leave REDIS_URL empty to disable. Nodes publish load_score to Redis for Gatekeeper routing.
# REDIS_URL=redis://127.0.0.1:6379
# NODE_ID=                         # Auto: {NODE_HOST}:{NODE_PORT}
# NODE_HOST=localhost
# NODE_PORT=9004

# --- Paths (usually auto-detected) ---
# VENV_PYTHON=venv/bin/python      # Override if venv is not in project dir

# --- Licence ---
COQUI_TOS_AGREED=1
