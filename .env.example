# --- Server Identity & Behavior ---
DEBUG=false
DEFAULT_LANGUAGE=en

# --- Infrastructure Paths ---
# Provide the absolute path to the Python executable in your venv
VENV_PYTHON=venv/bin/python
# Provide the absolute path to the 'tts' script in your venv
TTS_SCRIPT=venv/bin/tts

# --- Storage & Asset Management ---
# Optional: Override default storage paths.
# If left commented, the server uses the 'assets/' subfolder relative to main_tts.py.
# AUDIO_CACHE_DIR=assets/cache
# TTS_HOME=assets/models
# VOICE_ASSET_DIR=assets/voices
