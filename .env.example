# --- Server Identity & Behavior ---
DEBUG=false

# Default Language
# Options: en, es, fr, de, it, pt, pl, tr, ru, nl, cs, ar, zh-cn, hu, ko, ja
DEFAULT_LANGUAGE=en

# Default TTS Model
# Current standard: tts_models/multilingual/multi-dataset/xtts_v2
# Check 'tts --list_models' for available models
TTS_MODEL=tts_models/multilingual/multi-dataset/xtts_v2

# --- Personality Defaults ---
# DEFAULT_TEMPERATURE=0.75
# DEFAULT_LENGTH_PENALTY=1.0
# DEFAULT_REPETITION_PENALTY=5.0
# DEFAULT_TOP_K=50
# DEFAULT_TOP_P=0.85

# --- Infrastructure Paths ---
# Provide the absolute path to the Python executable in your venv
# VENV_PYTHON=venv/bin/python

# --- Storage & Asset Management ---
# Optional: Override default storage paths.
# If left commented, the server uses the 'assets/' subfolder relative to main_tts.py.
# AUDIO_CACHE_DIR=assets/cache
# TTS_HOME=assets/models
# VOICE_ASSET_DIR=assets/voices
#
# Cache TTL in minutes. Files older than this value are re-synthesized.
# Default: 10080 (7 days). Set to 0 to disable expiration.
CACHE_TTL_MINUTES=10080
#
# Cold Lane timeout in seconds. Subprocess is killed if it exceeds this limit.
# Default: 120s. Increase if your hardware needs more time to load the model.
COLD_LANE_TIMEOUT_SECONDS=120
#
# --- Smart Hot-Lane Routing ---
# Estimated cold lane startup time on your hardware (model load + first synthesis ready).
# Measure it once: time how long a cold lane subprocess takes from spawn to audio output.
# The router uses this to decide whether waiting for the hot lane is cheaper than spawning
# a new cold lane. Default: 10.0s (typical RTX 50-series cold start).
COLD_START_TIME_SECONDS=10.0
#
# Safety margin applied to the hot-queue drain estimate.
# 0.8 means "queue hot only if we expect to finish at least 20% before the cold lane would
# be ready". Lower = more conservative (bias toward cold lane). Range: 0.0–1.0.
HOT_QUEUE_SAFETY_FACTOR=0.8
#
# --- Licence agreement ---
COQUI_TOS_AGREED=1
COQUI_TTS_NON_COMMERCIAL=1
